{
  "name": "@rutba/office-formats",
  "version": "1.0.0",
  "license": "AGPL-3.0-or-later",
  "description": "What a file is and who opens it: magic-byte sniffing, the format registry, and readers for the formats the OOXML engine does not own — ODF (odt/ods/odp), RTF, legacy CFB (doc/xls/ppt), plain text, GitHub-flavoured Markdown, CSV and iCalendar.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./sniff": "./src/sniff.js",
    "./registry": "./src/registry.js",
    "./cfb": "./src/cfb.js",
    "./cfb-write": "./src/cfb-write.js",
    "./codepage": "./src/codepage.js",
    "./msword": "./src/msword.js",
    "./msdoc-docx": "./src/msdoc-docx.js",
    "./msxls": "./src/msxls.js",
    "./msxls-xlsx": "./src/msxls-xlsx.js",
    "./msppt": "./src/msppt.js",
    "./crypt": "./src/crypt.js",
    "./crypt-binary": "./src/crypt-binary.js",
    "./odf": "./src/odf.js",
    "./odf-write": "./src/odf-write.js",
    "./odf-geometry": "./src/odf-geometry.js",
    "./odt": "./src/odt.js",
    "./odt-docx": "./src/odt-docx.js",
    "./docx-read": "./src/docx-read.js",
    "./odt-write": "./src/odt-write.js",
    "./doc-export": "./src/doc-export.js",
    "./html-read": "./src/html-read.js",
    "./rtf": "./src/rtf.js",
    "./text": "./src/text.js",
    "./markdown": "./src/markdown.js",
    "./xml": "./src/xml.js",
    "./themes": "./src/themes.js"
  },
  "dependencies": {
    "@rutba/ooxml": "*"
  },
  "sideEffects": false
}
