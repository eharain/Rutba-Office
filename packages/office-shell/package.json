{
  "name": "@rutba/office-shell",
  "version": "1.0.0",
  "license": "AGPL-3.0-or-later",
  "description": "The platform port: every OS capability Rutba Office needs (files, dialogs, windows, menus, secrets, shell) behind one interface, with an Electron backend. A second backend (Tauri) can be added without touching an app.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./contract": "./src/contract.js",
    "./links": "./src/links.js",
    "./electron/main": "./src/electron/main.js",
    "./electron/profile-choice": "./src/electron/profile-choice.js",
    "./electron/clipboard": "./src/electron/clipboard.js",
    "./electron/shortcuts": "./src/electron/shortcuts.js",
    "./electron/machine-fakes": "./src/electron/machine-fakes.js",
    "./electron/packs": "./src/electron/packs.js",
    "./electron/pack-install": "./src/electron/pack-install.js",
    "./electron/pack-resolve": "./src/electron/pack-resolve.js",
    "./electron/preload": "./src/electron/preload.cjs",
    "./client": "./src/client.js",
    "./runs": "./src/runs.js",
    "./profiles": "./src/profiles.js",
    "./profile-keystore": "./src/profile-keystore.js",
    "./pack-tools": "./src/pack-tools.js"
  },
  "sideEffects": false,
  "dependencies": {
    "@tech-style/secure-keystore": "3.0.0"
  }
}
