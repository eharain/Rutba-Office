    "./build": "./src/build.js",
    "./units": "./src/units.js",
    "./motion": "./src/motion.js",
    "./timing": "./src/timing.js",
    "./narration": "./src/narration.js",
    "./patterns": "./src/patterns.js",
    "./shape3d": "./src/shape3d.js",
    "./points": "./src/points.js",
    "./changes": "./src/changes.js"
